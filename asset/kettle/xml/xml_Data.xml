<mujoco model="articulated_kettle">
    <compiler angle="radian" autolimits="false"/>

    <default>
        <!-- High sliding+torsional+rolling friction so the round bail wire does
             not roll out of the parallel-gripper pinch (applied to the handle via
             childclass; spliced into the scene <default> by build_scene_xml). -->
        <default class="bail">
            <geom condim="6" friction="2.0 0.2 0.05"/>
        </default>
    </default>

    <asset>
        <mesh name="body_mesh" file="../meshes/obj/body.obj" scale="1.0 1.0 1.0"/>
        <mesh name="handle_mesh" file="../meshes/obj/handle.obj" scale="1.0 1.0 1.0"/>
        <mesh name="cap_mesh" file="../meshes/obj/cap.obj" scale="1.0 1.0 1.0"/>
    </asset>

    <worldbody>
        <body name="mug" pos="0 0 0" euler="0 0 3.14">
            <freejoint name="mug_jnt"/>

            <!-- Keep the free-joint object frame at the physical bottom center.
                 The kettle collision bottom was z=-0.100 in the original asset. -->
            <body name="kettle_body" pos="0 0 0.100">
            <inertial pos="-0.024 0 -0.043" mass="0.25" diaginertia="0.0010 0.0010 0.0008"/>

            <!-- Visual meshes (no collision) — body and cap are rigidly attached -->
            <geom type="mesh" mesh="body_mesh" name="visual_body" contype="0" conaffinity="0" group="1"/>
            <geom type="mesh" mesh="cap_mesh" name="visual_cap" contype="0" conaffinity="0" group="1"/>

            <!-- Collision: main body — pot shape approximated with 2 stacked cylinders -->
            <!-- Lower/wide region: radius=0.068, z from -0.100 to -0.010 -->
            <geom type="cylinder" size="0.068 0.045" pos="0 0 -0.055" rgba="0.3 0.3 0.3 0.3" name="collision_body_lower" group="3"/>
            <!-- Upper/neck region: radius=0.050, z from -0.012 to 0.012 -->
            <geom type="cylinder" size="0.037 0.012" pos="0 0 0.000" rgba="0.3 0.3 0.3 0.3" name="collision_body_upper" group="3"/>

            <!-- Collision: cap (fixed to body) -->
            <geom type="cylinder" size="0.037 0.012" pos="0 0 0.000" rgba="0.3 0.3 0.3 0.3" name="collision_cap" group="3"/>

            <!-- Collision: spout (extends in -x direction) -->
            <!-- Base to mid: tapers from body wall -->
            <geom type="capsule" fromto="-0.068 0 -0.050 -0.095 0 -0.025" size="0.015" rgba="0.3 0.3 0.3 0.3" name="collision_spout_1" group="3"/>
            <!-- Mid to tip: narrow spout -->
            <geom type="capsule" fromto="-0.095 0 -0.025 -0.118 0 0.003" size="0.008" rgba="0.3 0.3 0.3 0.3" name="collision_spout_2" group="3"/>

            <!-- CoM visualization -->
            <!-- <geom type="sphere" size="0.01" pos="-0.024 0 -0.043" rgba="0 0 1 1" contype="0" conaffinity="0" name="com_body"/> -->

            <body name="handle" pos="0 0 0" childclass="bail">
                <inertial pos="0 -0.045 0.007" mass="0.05" diaginertia="0.0001 0.0001 0.0001"/>

                <!-- Hinge: a soft spring (springref ~ -1.0) holds the bail at a
                     slightly tilted, graspable pose while still articulating
                     freely (yields easily under the gripper / rack branch). -->
                <joint name="kettle_handle_hinge" type="hinge" pos="0 0.008 -0.001" axis="1 0 0" range="-2.0 -1.0" damping="0.0" armature="0.00" stiffness="0.0" springref="0.0"/>

                <!-- Visual mesh (no collision) -->
                <geom type="mesh" mesh="handle_mesh" name="visual_handle" contype="0" conaffinity="0" group="1"/>

                <!-- Collision: 8 capsules tracing the U-shaped bail handle -->
                <!-- Handle wire radius ~0.007 -->
                <!-- Right arm: from attachment down -->
                <geom type="capsule" fromto="0.069 0.008 -0.001 0.067 -0.025 0.004" size="0.007" rgba="0.3 0.3 0.3 0.3" name="collision_handle_1" group="3"/>
                <geom type="capsule" fromto="0.067 -0.025 0.004 0.060 -0.055 0.009" size="0.007" rgba="0.3 0.3 0.3 0.3" name="collision_handle_2" group="3"/>
                <!-- Right corner to center bottom -->
                <geom type="capsule" fromto="0.060 -0.055 0.009 0.045 -0.074 0.010" size="0.007" rgba="0.3 0.3 0.3 0.3" name="collision_handle_3" group="3"/>
                <!-- Bottom arc: right corner to left corner -->
                <geom type="capsule" fromto="0.045 -0.074 0.010 -0.045 -0.074 0.010" size="0.008" rgba="0.3 0.3 0.3 0.3" name="collision_handle_4" group="3"/>
                <geom type="capsule" fromto="-0.045 -0.074 0.010 -0.060 -0.055 0.009" size="0.007" rgba="0.3 0.3 0.3 0.3" name="collision_handle_5" group="3"/>
                <!-- Left arm: up to attachment -->
                <geom type="capsule" fromto="-0.060 -0.055 0.009 -0.067 -0.025 0.004" size="0.007" rgba="0.3 0.3 0.3 0.3" name="collision_handle_6" group="3"/>
                <geom type="capsule" fromto="-0.067 -0.025 0.004 -0.069 0.008 -0.001" size="0.007" rgba="0.3 0.3 0.3 0.3" name="collision_handle_7" group="3"/>

                <!-- CoM visualization -->
                <!-- <geom type="sphere" size="0.01" pos="0 -0.045 0.007" rgba="0 0 1 1" contype="0" conaffinity="0" name="com_handle"/> -->
            </body>
            </body>
        </body>
    </worldbody>

    <contact>
        <!-- Handle capsules vs body lower cylinder (7 pairs) -->
        <pair geom1="collision_body_lower" geom2="collision_handle_1"/>
        <pair geom1="collision_body_lower" geom2="collision_handle_2"/>
        <pair geom1="collision_body_lower" geom2="collision_handle_3"/>
        <pair geom1="collision_body_lower" geom2="collision_handle_4"/>
        <pair geom1="collision_body_lower" geom2="collision_handle_5"/>
        <pair geom1="collision_body_lower" geom2="collision_handle_6"/>
        <pair geom1="collision_body_lower" geom2="collision_handle_7"/>

        <!-- Handle capsules vs body upper cylinder (7 pairs) -->
        <pair geom1="collision_body_upper" geom2="collision_handle_1"/>
        <pair geom1="collision_body_upper" geom2="collision_handle_2"/>
        <pair geom1="collision_body_upper" geom2="collision_handle_3"/>
        <pair geom1="collision_body_upper" geom2="collision_handle_4"/>
        <pair geom1="collision_body_upper" geom2="collision_handle_5"/>
        <pair geom1="collision_body_upper" geom2="collision_handle_6"/>
        <pair geom1="collision_body_upper" geom2="collision_handle_7"/>

        <!-- Handle capsules vs cap (7 pairs) -->
        <pair geom1="collision_cap" geom2="collision_handle_1"/>
        <pair geom1="collision_cap" geom2="collision_handle_2"/>
        <pair geom1="collision_cap" geom2="collision_handle_3"/>
        <pair geom1="collision_cap" geom2="collision_handle_4"/>
        <pair geom1="collision_cap" geom2="collision_handle_5"/>
        <pair geom1="collision_cap" geom2="collision_handle_6"/>
        <pair geom1="collision_cap" geom2="collision_handle_7"/>

        <!-- Handle capsules vs spout (2 x 7 = 14 pairs) -->
        <pair geom1="collision_spout_1" geom2="collision_handle_1"/>
        <pair geom1="collision_spout_1" geom2="collision_handle_2"/>
        <pair geom1="collision_spout_1" geom2="collision_handle_3"/>
        <pair geom1="collision_spout_1" geom2="collision_handle_4"/>
        <pair geom1="collision_spout_1" geom2="collision_handle_5"/>
        <pair geom1="collision_spout_1" geom2="collision_handle_6"/>
        <pair geom1="collision_spout_1" geom2="collision_handle_7"/>

        <pair geom1="collision_spout_2" geom2="collision_handle_1"/>
        <pair geom1="collision_spout_2" geom2="collision_handle_2"/>
        <pair geom1="collision_spout_2" geom2="collision_handle_3"/>
        <pair geom1="collision_spout_2" geom2="collision_handle_4"/>
        <pair geom1="collision_spout_2" geom2="collision_handle_5"/>
        <pair geom1="collision_spout_2" geom2="collision_handle_6"/>
        <pair geom1="collision_spout_2" geom2="collision_handle_7"/>
    </contact>

</mujoco>
